-- Sorting in table
CREATE TABLE test_ulids (id ulid);
INSERT INTO test_ulids VALUES
  ('7ZZZZZZZZZZZZZZZZZZZZZZZZZ'),
  ('00000000000000000000000000'),
  ('01H58HW7T70008RS65ZCAH32KF'),
  ('0B7RR1YKW8M15S17RGPJ287K4T'),
  ('3GDQGKJ6TH887R4YHZ4KGABYF3'),
